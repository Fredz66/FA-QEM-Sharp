<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>FaQemSharp</PackageId>
    <Version>0.1.1</Version>
    <Authors>Frédéric Lopez</Authors>
    <Description>Independent C# FA-QEM implementation: GLB simplification, successive mapping, compact UV islands, lossless atlas baking and quality reports.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Fredz66/FA-QEM-Sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Fredz66/FA-QEM-Sharp</PackageProjectUrl>
    <PackageTags>FA-QEM;mesh;GLB;simplification;textures</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="cli/**" />
    <None Remove="cli/**" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
