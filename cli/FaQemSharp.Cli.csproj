<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>faqem</ToolCommandName>
    <PackageId>FaQemSharp.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Frédéric Lopez</Authors>
    <Description>Command-line tool that reduces a textured GLB with the FaQemSharp FA-QEM pipeline and saves its quality report. Windows x64.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Fredz66/FA-QEM-Sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Fredz66/FA-QEM-Sharp</PackageProjectUrl>
    <PackageTags>FA-QEM;mesh;GLB;simplification;textures;cli;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FaQemSharp.csproj" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
